# Copy to .env for `npm run dev` (API on :8080, web app on http://localhost:5173).
# The NAS and the account are set up in the app, on the first start. AllDebrid's address is built
# in.
# Optional, the key can also be entered in the Settings page:
# ALLDEBRID_API_KEY=
DATA_DIR=./data
LOG_LEVEL=debug

# Without a NAS: `npm run dev:mock` runs a fake NAS and fake debrid services on :5055. In the
# app, connect Download Station with http://localhost:5055 and admin / admin. For the fake debrid
# services, add these lines:
# ALLDEBRID_API_URL=http://localhost:5055/alldebrid
# ALLDEBRID_API_KEY=mock
